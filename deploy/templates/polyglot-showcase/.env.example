# Copy to .env, fill in random values. Generate URL-safe 32-char with:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRETS_ENCRYPTION_KEY=
POLYGLOT_ENGINE_PASSWORD=

SITE_URL=https://polyglot.example.com
ALLOWED_ORIGINS=

# Concurrent WS connections per source IP. Dashboard opens 18 subs per
# viewer; default 10 floors 8 of them with 429. 50 leaves headroom.
WS_MAX_PER_IP=50
# Umbrella nginx terminates TLS one hop before pgstack — set to the
# umbrella's network IP / range so the per-IP cap applies per-viewer
# instead of per-deployment. Empty = trust no proxies (every viewer
# looks like the gateway).
TRUSTED_PROXIES=

# Image overrides — pin to specific tags or local dev builds.
PGSTACK_IMAGE=pgstack/pgstack:latest
WEB_IMAGE=pgstack/polyglot-web:latest
GENERATOR_IMAGE=pgstack/polyglot-generator:latest
ENGINE_GO_IMAGE=pgstack/polyglot-engine-go:latest
ENGINE_NODE_IMAGE=pgstack/polyglot-engine-node:latest
ENGINE_FASTAPI_IMAGE=pgstack/polyglot-engine-fastapi:latest
ENGINE_RUST_IMAGE=pgstack/polyglot-engine-rust:latest
ENGINE_DOTNET_IMAGE=pgstack/polyglot-engine-dotnet:latest
ENGINE_SPRING_IMAGE=pgstack/polyglot-engine-spring:latest

# Order-flow knobs (generator).
MID_PRICE=50000
SPREAD=25
ORDERS_PER_SEC=4
MAX_QTY=1.5
CANCEL_RATE=0.05
