# Copy to .env, fill in random values. Generate URL-safe 32-char with:
#   LC_ALL=C tr -dc 'A-Za-z0-9' </dev/urandom | head -c 32

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRETS_ENCRYPTION_KEY=
POLYGLOT_ENGINE_PASSWORD=

SITE_URL=https://polyglot.example.com
ALLOWED_ORIGINS=

# Image overrides — pin to specific tags or local dev builds.
PGSTACK_IMAGE=pgstack/pgstack:latest
WEB_IMAGE=pgstack/polyglot-web:latest
GENERATOR_IMAGE=pgstack/polyglot-generator:latest
ENGINE_GO_IMAGE=pgstack/polyglot-engine-go:latest

# Order-flow knobs (generator).
MID_PRICE=50000
SPREAD=25
ORDERS_PER_SEC=4
MAX_QTY=1.5
CANCEL_RATE=0.05
