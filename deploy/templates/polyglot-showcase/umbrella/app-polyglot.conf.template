# polyglot.example.com — umbrella nginx routing for the polyglot
# matching-engine showcase. Drop into /opt/proxy/nginx/conf.d/ on the
# VPS (the tracked deploy/umbrella/app-polyglot.conf in the repo is the
# auto-deployed copy of this template; this file in the template directory
# is for first-time manual setup or for operators running the showcase
# outside the canonical deploy pipeline).

server {
    listen 443 ssl;
    http2 on;
    listen [::]:443 ssl;

    # CHANGE ME — subdomain pointing at this VPS.
    server_name polyglot.example.com;

    include /etc/nginx/snippets/ssl.conf;
    include /etc/nginx/snippets/cloudflare-realip.conf;

    # Static dashboard at the root.
    location / {
        set $polyglot_web http://polyglot-web:80;
        proxy_pass $polyglot_web;
        include /etc/nginx/snippets/proxy-headers.conf;
    }

    # pgstack endpoints — auth, REST, WS subscriptions, edge functions —
    # all live on the proxy inside polyglot-pgstack. The static web image
    # is plain nginx so it does NOT proxy these; umbrella routes them
    # directly to the gateway alias of the pgstack container.
    location ~ ^/(auth|rest|ws|api|functions)/ {
        set $polyglot_pgstack http://polyglot-pgstack:8080;
        proxy_pass $polyglot_pgstack;
        include /etc/nginx/snippets/proxy-headers.conf;
    }
}
