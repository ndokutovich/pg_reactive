# Copy to .env and replace every value. Generate the random ones with:
#   openssl rand -base64 32 | tr -dc 'A-Za-z0-9' | head -c 32
# (URL-safe alphabet — base64's +/= break URL parsing in pgx; see
# scripts/bootstrap-env.sh for the canonical generator.)

POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=
SECRETS_ENCRYPTION_KEY=

# Subdomain this shop lives at. Must match server_name in the umbrella's
# nginx/conf.d/app-shop.conf (lives in your reverse-proxy repo) AND be
# reachable via your wildcard cert (*.yourdomain.com).
SITE_URL=https://shop.example.com

# Cross-origin CORS. Empty + ALLOW_PERMISSIVE_CORS=false (default) = strict
# same-origin only. Leave blank if the shop runs at its own subdomain.
ALLOWED_ORIGINS=

# Concurrent WS connections per source IP. Each viewer opens 1-2 subs;
# 20 leaves headroom for stale-slot decay during reconnect bursts.
WS_MAX_PER_IP=20
# Umbrella nginx terminates TLS one hop before pgstack — set to the
# umbrella's network IP / range so the per-IP cap applies per-viewer
# instead of per-deployment. Empty = trust no proxies.
TRUSTED_PROXIES=

# Which frontend variant to deploy. Pick one and `docker compose up -d`
# again to swap — image takes seconds to start, no rebuild required.
# Available: pgstack/shopping-{vanilla,react,vue,svelte,angular}:latest
FRONTEND_IMAGE=pgstack/shopping-vanilla:latest

# pgstack all-in-one image (PG + pg_reactive + proxy). Override to a
# locally-built `pgstack-all-in-one:dev` tag when you're iterating off
# the in-tree docker/Dockerfile.all-in-one before any registry push.
PGSTACK_IMAGE=pgstack/pgstack:latest

# Optional — point at a real SMTP if you want password-reset / magic-link
# emails actually delivered. Defaults wire to the sibling Inbucket catcher.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USER=apikey
# SMTP_PASS=...
