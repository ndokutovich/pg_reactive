# pgStack Environment Variables
# Copy to .env and fill in real values before running in production.
# Generate secrets: openssl rand -base64 32

# ── Host Ports ────────────────────────────────────────────────────────────────
# Override these when running multiple pgStack-based projects on one machine.
# Defaults match the dev stack; pick non-colliding values per project.
PG_PORT=15432         # PostgreSQL host port (mapped to 5432 inside)
PROXY_PORT=8080       # Go proxy host port  (REST/WS/auth/functions)
PROXY_RUST_PORT=8081  # legacy Rust proxy host port (root compose only)
WEB_PORT=3000         # Examples landing nginx host port

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_DB=app
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-strong-password
# Login password for the powerless `authenticator` role the proxy connects as
# (NOT the superuser) — gemini audit P2. Must be URL-safe. `bootstrap-env.sh`
# generates it; the db and proxy services share this one value.
AUTHENTICATOR_PASSWORD=change-me-authenticator-password

# ── Proxy API Keys ────────────────────────────────────────────────────────────
# Must be 32+ characters. Generate: openssl rand -base64 32
JWT_SECRET=change-me-at-least-32-characters-long

# These are opaque API keys (not JWTs) for anonymous and admin access.
# Generate: openssl rand -base64 32
ANON_KEY=change-me-anon-key
SERVICE_ROLE_KEY=change-me-service-role-key

# ── Application URL ───────────────────────────────────────────────────────────
# Required for OAuth redirects. Must match your domain exactly.
SITE_URL=https://your-app.example.com

# ── OAuth Providers (optional) ────────────────────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# GitHub: https://github.com/settings/developers
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── SMTP (optional — required for email verification, magic links) ─────────────
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@your-app.example.com

# ── Tuning ────────────────────────────────────────────────────────────────────
PROXY_PORT=8080
MAX_CONNECTIONS=10000
ACCESS_TOKEN_EXPIRY_SECS=3600
REFRESH_TOKEN_EXPIRY_DAYS=30
MAX_BODY_SIZE=1048576

# CORS / WebSocket origin allow-list. Comma-separated, no wildcards.
# Empty + ALLOW_PERMISSIVE_CORS=false (default since 2026-05) = strict:
#   no Access-Control-Allow-Origin emitted; cross-origin browsers blocked;
#   same-origin and non-browser clients still work.
# Empty + ALLOW_PERMISSIVE_CORS=true = dev mode: reflect any Origin.
# Example: https://your-app.example.com,https://admin.example.com
ALLOWED_ORIGINS=
ALLOW_PERMISSIVE_CORS=false

# Realtime hardening: when true, anon-key WS subscriptions are rejected;
# /ws/{query_id} requires a JWT (authenticated or service_role).
# Set this whenever live queries return user-scoped data.
REQUIRE_AUTHENTICATED_WS=false

# Demo endpoint (mutates demo tables). Off by default. Even when false,
# the route is still mounted if SERVICE_ROLE_KEY is set (and then requires it).
ENABLE_DEMO_ENDPOINT=false

# At-rest encryption key for credentials persisted in the database
# (currently: edge function env vars). 32 raw bytes, base64-encoded.
# Generate one with: openssl rand -base64 32
# Unset = encryption disabled; rows with encrypted secrets fail to load
# loudly. Required for any deployment that uses edge function env vars.
SECRETS_ENCRYPTION_KEY=

# ── HTTP Server ──────────────────────────────────────────────────────────────
# Timeouts in seconds
READ_TIMEOUT=30
WRITE_TIMEOUT=60
IDLE_TIMEOUT=120
SHUTDOWN_TIMEOUT=15

# Gzip compression level (0=disabled, 1=fastest, 9=best, 5=balanced)
GZIP_LEVEL=5

# ── PostgreSQL Connection Pool ───────────────────────────────────────────────
PG_POOL_MAX_CONNS=50
PG_POOL_MIN_CONNS=5
PG_POOL_MAX_CONN_IDLE_TIME=300

# ── TLS / HTTPS ──────────────────────────────────────────────────────────────
# off    = plain HTTP (default; use reverse proxy for TLS in production)
# auto   = automatic Let's Encrypt via ACME (requires ports 80+443, public DNS)
# manual = user-provided cert/key files
TLS_MODE=off

# For TLS_MODE=auto:
TLS_DOMAINS=app.example.com
TLS_CERT_DIR=/data/certs
TLS_ACME_EMAIL=admin@example.com

# For TLS_MODE=manual:
TLS_CERT_FILE=
TLS_KEY_FILE=

# Listen addresses for TLS modes (ignored when TLS_MODE=off)
HTTPS_ADDR=:443
HTTP_ADDR=:80
