FROM postgres:16-bookworm

# Install build tools
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-16 \
    && rm -rf /var/lib/apt/lists/*

# Copy and build the extension
COPY ext/ /tmp/ext/
RUN make -C /tmp/ext clean && make -C /tmp/ext && make -C /tmp/ext install \
    && rm -rf /tmp/ext

# Bootstrap pgstack schema, auth tables, and roles on first start
COPY docker/init.sql /docker-entrypoint-initdb.d/01-init.sql

# Make the `authenticator` role LOGIN-able from AUTHENTICATOR_PASSWORD so the
# proxy connects as a non-superuser (gemini audit P2). Runs after 01-init.sql.
COPY --chmod=0755 docker/20-authenticator-login.sh /docker-entrypoint-initdb.d/20-authenticator-login.sh

# Copy example setup scripts (used by the setup service)
COPY examples/ /examples/
