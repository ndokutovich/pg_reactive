{
  "name": "pgstack",
  "version": "0.1.1",
  "description": "Postgres-native backend platform. One PostgreSQL. Zero extra containers.",
  "type": "module",
  "bin": {
    "pgstack": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "test": "vitest run",
    "prepublishOnly": "npm run build"
