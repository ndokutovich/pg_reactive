# Canonical all-in-one pgStack image: PostgreSQL + pg_reactive C extension +
# pgstack Go proxy + the bootstrap schema, in a single container.
#
# ┌─ DEMO / SINGLE-TENANT QUICKSTART — NOT the hardened production posture ─────┐
# │ This image CO-LOCATES PostgreSQL and the proxy in one container, so a proxy │
# │ compromise can reach the database directly: the "proxy runs as a powerless  │
# │ role, never the superuser" guarantee (SECURITY.md invariant 22) holds only  │
# │ across the container boundary of the SPLIT deployment. It also builds on     │
# │ mutable base tags and does NOT go through the build-once / promote-by-digest │
# │ release pipeline (which publishes only pgstack-proxy + pgstack-postgres).    │
# │ For multi-tenant production use the split GHCR images — docker-compose.prod. │
# │ yml. Use this all-in-one for demos and single-tenant hobby deployments.      │
# └────────────────────────────────────────────────────────────────────────────┘
#
# Build context = the pg_reactive repo root:
#   docker build -f docker/Dockerfile.all-in-one -t pgstack-all-in-one .
#
# Directly usable for a demo / single-tenant deployment that needs no extra
# bundled content.
# Deployments that bundle a frontend / docs / studio (e.g. the umbrella's
# apps/pg-reactive and apps/longtask-template, or roblox-clone-app) write
# their own Dockerfile but should MIRROR this runtime stage and COPY the
# canonical docker/all-in-one-entrypoint.sh rather than duplicating it.
#
# GUC flags: pass via the compose `command:` — forwarded to postgres.
# Deployment setup: ship an executable /app/post-init.sh (see the entrypoint).

# ── Stage 1: pgstack Go proxy ────────────────────────────────────────────────
FROM golang:1.23-bookworm AS proxy-builder
WORKDIR /app
ENV GOTOOLCHAIN=auto
COPY proxy-go/go.mod proxy-go/go.sum ./
RUN go mod download
COPY proxy-go/ .
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-s -w" -o pgstack-proxy .

# ── Stage 2: all-in-one runtime ──────────────────────────────────────────────
FROM postgres:16-bookworm
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential postgresql-server-dev-16 ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# Compile + install the pg_reactive C extension.
COPY ext/ /tmp/ext/
RUN make -C /tmp/ext clean && make -C /tmp/ext && make -C /tmp/ext install \
    && rm -rf /tmp/ext

# The stock postgres entrypoint regenerates postgresql.conf from the sample on
# first init — patch the sample so PostgreSQL listens on TCP for the
# in-container proxy (and any sibling worker containers). It is never
# host-exposed unless the deployment maps a port.
RUN echo "listen_addresses = '*'" >> /usr/share/postgresql/postgresql.conf.sample

COPY --from=proxy-builder /app/pgstack-proxy /usr/local/bin/pgstack-proxy
COPY docker/init.sql /docker-entrypoint-initdb.d/01-init.sql
COPY docker/all-in-one-entrypoint.sh /usr/local/bin/entrypoint.sh
RUN chmod 0755 /usr/local/bin/entrypoint.sh

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/entrypoint.sh"]
