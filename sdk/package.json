{
  "name": "@pgstack/sdk",
  "version": "0.2.0",
  "description": "TypeScript SDK for pg_reactive live queries",
  "license": "Apache-2.0",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./pgstack": {
      "import": "./dist/pgstack.js",
      "types": "./dist/pgstack.d.ts"
    },
    "./pgstack-react": {
      "import": "./dist/pgstack-react.js",
      "types": "./dist/pgstack-react.d.ts"
    },
    "./dbos": {
      "import": "./dist/dbos/index.js",
      "types": "./dist/dbos/index.d.ts"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc",
    "prepack": "npm run build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@stryker-mutator/core": "^9.6.0",
    "@stryker-mutator/typescript-checker": "^9.6.0",
    "@stryker-mutator/vitest-runner": "^9.6.0",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.0.0",
    "fast-check": "^4.6.0",
    "jsdom": "^25.0.1",
    "pg": "^8.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "typescript": "^5.4",
    "vitest": "^4.0.18",
    "ws": "^8.19.0"
  },
  "peerDependencies": {
    "pg": ">=8",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
