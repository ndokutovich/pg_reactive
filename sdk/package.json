{
  "name": "pg-reactive-sdk",
  "version": "0.1.0",
  "description": "TypeScript SDK for pg_reactive live queries",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./react": {
      "import": "./dist/react.js",
      "types": "./dist/react.d.ts"
    },
    "./server": {
      "import": "./dist/server.js",
      "types": "./dist/server.d.ts"
    },
    "./pgstack": {
      "import": "./dist/pgstack.js",
      "types": "./dist/pgstack.d.ts"
    },
    "./pgstack-react": {
      "import": "./dist/pgstack-react.js",
      "types": "./dist/pgstack-react.d.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/pg": "^8.16.0",
    "@types/react": "^19.2.14",
    "pg": "^8.18.0",
    "typescript": "^5.4",
    "vitest": "^4.0.18",
    "ws": "^8.19.0"
  },
  "peerDependencies": {
    "pg": ">=8",
    "react": ">=18"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}
