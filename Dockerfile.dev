FROM postgres:16-bookworm

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    postgresql-server-dev-16 \
    postgresql-plpython3-16 \
    python3 \
    python3-pip \
    python3-psycopg2 \
    && (apt-get install -y --no-install-recommends postgresql-16-plv8 || true) \
    && rm -rf /var/lib/apt/lists/*

# Copy extension source, tests, and examples at build time
# (bind mounts cause OOM on WSL2)
COPY --chown=postgres:postgres ext/ /ext/ext/
COPY --chown=postgres:postgres tests/ /ext/tests/
COPY --chown=postgres:postgres examples/ /examples/

# Init SQL runs on every fresh start (tmpfs wipes state). Per-example
# tables and policies live in their own examples/*/setup.sql files,
# applied by the examples/docker-compose.yml `setup` service — they
# are NOT part of the base image so the base PG can be reused by
# stacks that don't want the demo schema.
COPY docker/init.sql /docker-entrypoint-initdb.d/01-init.sql

# Runs after 01-init.sql: makes `authenticator` LOGIN-able from
# AUTHENTICATOR_PASSWORD so the proxy connects as a non-superuser (gemini audit
# P2). No-op (role stays NOLOGIN, fail-closed) when the env var is absent.
COPY --chmod=0755 docker/20-authenticator-login.sh /docker-entrypoint-initdb.d/20-authenticator-login.sh

COPY docker/entrypoint-dev.sh /usr/local/bin/entrypoint-dev.sh
RUN chmod +x /usr/local/bin/entrypoint-dev.sh

ENTRYPOINT ["entrypoint-dev.sh"]
CMD ["postgres"]
